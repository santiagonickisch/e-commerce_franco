# Configuración de Backup - Franco Salon Exclusivo
# Copia este archivo como .env y configura las variables

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=franco_salon_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ========================================
# CONFIGURACIÓN DE BACKUP
# ========================================
# Directorio donde se guardan los backups
BACKUP_DIR=./backups

# Directorio para backups de archivos
FILES_BACKUP_DIR=./backups/files

# Directorio temporal para procesamiento
TEMP_DIR=./temp

# Número máximo de backups a mantener (días)
MAX_BACKUPS=30
MAX_FILE_BACKUPS=7

# Compresión de backups (true/false)
BACKUP_COMPRESSION=true
FILES_BACKUP_COMPRESSION=true

# ========================================
# CONFIGURACIÓN DE NOTIFICACIONES
# ========================================
# Habilitar notificaciones por email
EMAIL_NOTIFICATIONS=false

# Email de destino para notificaciones
EMAIL_TO=admin@francosalonexclusivo.com

# Email de origen para notificaciones
EMAIL_FROM=backup@francosalonexclusivo.com

# ========================================
# CONFIGURACIÓN DE AUTOMATIZACIÓN
# ========================================
# Hora para backup automático (formato 24h)
BACKUP_HOUR=02

# Día de la semana para backup completo (0=domingo, 1=lunes, etc.)
BACKUP_DAY=0

# ========================================
# CONFIGURACIÓN DE LOGGING
# ========================================
# Directorio para logs
LOG_DIR=./logs

# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================
# Encriptar backups (true/false)
ENCRYPT_BACKUPS=false

# Clave para encriptación (solo si ENCRYPT_BACKUPS=true)
ENCRYPTION_KEY=tu_clave_de_encriptacion_aqui

# ========================================
# CONFIGURACIÓN DE CLOUD STORAGE
# ========================================
# Subir backups a cloud storage (true/false)
UPLOAD_TO_CLOUD=false

# Tipo de cloud storage (aws, gcp, azure)
CLOUD_PROVIDER=aws

# Configuración AWS S3
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_BUCKET_NAME=tu_bucket_name
AWS_REGION=us-east-1

# ========================================
# CONFIGURACIÓN DE MONITOREO
# ========================================
# Habilitar monitoreo de espacio en disco
MONITOR_DISK_SPACE=true

# Umbral mínimo de espacio libre (GB)
MIN_FREE_SPACE_GB=5

# Habilitar alertas por espacio bajo
ALERT_LOW_SPACE=true
